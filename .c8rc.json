{
  "all": true,

  "include": ["src/**/*.ts"],
  "exclude": ["src/**/*.d.ts"],
  "excludeAfterRemap": true,

  "reporter": ["cobertura", "html", "text", "text-summary"],

  "checkCoverage": true,

  "statements": 90,
  "branches": 85,
  "functions": 90,
  "lines": 90,

  "watermarks": {
    "statements": [75, 85],
    "branches": [75, 85],
    "functions": [75, 85],
    "lines": [75, 85]
  }
}
