{
  "name": "wcc-workspace",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.23.0",
  "scripts": {
    "lint": "pnpm run lint:js && pnpm run lint:ls && pnpm run lint:css",
    "lint:js": "eslint --flag unstable_native_nodejs_ts_config",
    "lint:ls": "ls-lint",
    "commit": "cz",
    "commit:lint": "commitlint --last --verbose",
    "commit:edit": "commitlint --edit $1",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "prepare": "husky",
    "build": "pnpm --filter wc-compiler run build",
    "build:watch": "pnpm --filter wc-compiler run build:watch",
    "test": "pnpm --filter wc-compiler run test",
    "test:jsx": "pnpm --filter wc-compiler run test:jsx",
    "test:tdd": "pnpm --filter wc-compiler run test:tdd",
    "test:tdd:jsx": "pnpm --filter wc-compiler run test:tdd:jsx",
    "jsx-types:generate": "pnpm --filter wc-compiler run jsx-types:generate",
    "jsx-types:check": "pnpm --filter wc-compiler run jsx-types:check",
    "docs:dev": "pnpm run build && pnpm --filter @wcc/docs run dev",
    "docs:build": "pnpm run build && pnpm --filter @wcc/docs run build",
    "docs:serve": "pnpm --filter @wcc/docs run serve",
    "test:docs": "pnpm --filter @wcc/docs run test",
    "test:docs:tdd": "pnpm --filter @wcc/docs run test:watch",
    "lint:css": "pnpm --filter @wcc/docs run lint:css",
    "check:types": "tsc && pnpm -r run check:types"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.1.0",
    "@commitlint/types": "^20.5.0",
    "@eslint/js": "^9.39.1",
    "@ls-lint/ls-lint": "^2.3.1",
    "@types/node": "^24.0.0",
    "commitizen": "^4.3.1",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-no-only-tests": "^3.3.0",
    "globals": "^15.10.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.6",
    "prettier": "^3.6.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1"
  }
}
